# gomutants configuration
# Copy this file to .gomutants.yml in your project root.
# All fields are optional — defaults are shown below.
# Priority: built-in defaults < this file < CLI flags.

# Number of parallel workers (default: number of CPUs).
workers: 10

# Value passed to inner `go test -cpu` per mutant. 0 (the default)
# omits the flag so go test inherits GOMAXPROCS. Pair --workers=1
# with a higher --test-cpu when you want one fat go-test child rather
# than many narrow ones.
test-cpu: 0

# Per-mutant timeout = baseline test duration * this coefficient (default: 10).
timeout-coefficient: 10

# Coverage package pattern passed to go test -coverpkg.
# Useful when your tests are in a separate package from the code under test.
# coverpkg: "./pkg/..."

# Comma-separated build tags forwarded as -tags to every inner go list / go
# test, so mutation testing reaches code behind //go:build constraints.
# tags: "integration,debug"

# Whitespace-separated flags forwarded verbatim to the inner go test runs
# (per-mutant, coverage, baseline) and to nothing else. Mainly for trading
# mutation fidelity for speed on property-based suites; changing this value
# invalidates the incremental cache, since verdicts recorded under one value
# don't describe another. Setting it also stands adaptive timeouts down to
# the global ceiling, since the per-test timings are measured without these
# flags. Flags gomutants manages (-overlay, -run, -args, -timeout,
# -coverprofile, -coverpkg, -c, -o, -exec) are rejected, in their -test.*
# spellings too.
# test-flags: "-short"

# JSON report output path (default: mutation-report.json).
output: mutation-report.json

# Suppress header, phase banners, per-mutant progress, and the trailing
# "Report:" line. Only the final summary block lands on stdout; stderr
# warnings are unaffected. Mutually exclusive with --verbose.
# quiet: false

# Scope mutation testing to lines changed since the given git ref
# (e.g. "origin/main", "HEAD~1"). Empty disables; --changed-since on
# the CLI overrides. Requires a git repository.
# changed-since: ""

# Incremental-analysis cache path. The default (".gomutants-cache.json")
# enables caching at that path; set to "off" to disable. Per-mutant
# outcomes are keyed by content hashes of the production file and the
# test files that cover the mutant (resolved from the per-test coverage
# map; falls back to all _test.go in the mutant's package directory).
# On the next run, mutants whose source and covering tests are byte-
# identical to the cached run are skipped.
# cache: .gomutants-cache.json

# How often to flush completed mutant outcomes to the cache file while a
# run is still in progress (default: 10s). A run killed mid-way — OOM, CI
# timeout, SIGKILL, double Ctrl-C — loses at most this much progress; the
# next invocation resumes from the last checkpoint instead of starting
# over. Set to 0s to disable periodic checkpointing (the cache is then
# written only once, at the end of the run). Ignored when cache is "off".
# checkpoint-interval: 10s

# Detect equivalent mutants via Trivial Compiler Equivalence (default:
# false). After testing, each surviving mutant is recompiled with
# package-scoped `-gcflags=-S`; if the generated assembly is identical to
# the original, the mutation was folded away by the compiler and can never
# be killed, so it's reclassified EQUIVALENT and dropped from the efficacy
# denominator. Sound (a killable mutant is never marked equivalent) but
# adds one package compile per survivor — opt-in.
# detect-equivalent: true

# Cross-package routing (default: false). Route each mutant to covering
# tests in any package that imports it — so a mutant can be killed by a
# cross-package/E2E test, not just tests in its own package. Widens
# coverage and the per-test build to the reverse-dependency closure of the
# target packages and manages -coverpkg itself (setting coverpkg too is an
# error). Slower; efficacy scores aren't comparable to a non-integration
# run. Opt-in.
# integration: true

# Mutator types to disable (run all except these).
# disable:
#   - BRANCH_IF
#   - BRANCH_ELSE

# Mutator types to run exclusively (disables all others).
# only:
#   - ARITHMETIC_BASE
#   - CONDITIONALS_NEGATION

# Skip mutating production files whose module-relative path (slash-
# separated, relative to the module root) matches any of these regexps.
# The match is unanchored, so "vendor/" hits anywhere in the path.
# Excluded files are dropped before discovery: they produce no mutants and
# are never parsed. Test files are never mutated regardless. --exclude-files
# on the CLI (comma-separated) overrides this list.
# exclude-files:
#   - vendor/
#   - _gen\.go$
#   - mocks/

# Suppress mutants inside calls whose selector matches one of these globs
# — the Go analogue of PITest's avoidCallsTo, for operators in logging and
# telemetry arguments that no test can reasonably assert on. Matching is
# anchored and `*` is the only metacharacter, so `log.Print` matches only
# `log.Print` while `log.Print*` also catches Printf/Println. The whole
# call expression is suppressed, argument list and all, including
# STATEMENT_REMOVE of a bare logging statement. Matching is syntactic: an
# aliased import (`import stdlog "log"`) needs its own entry. Suppressed
# mutants are dropped before any test runs and counted in
# mutants_suppressed. --exclude-calls on the CLI (comma-separated)
# overrides this list.
#
# This list EXTENDS the built-in set for Go's standard-library logging:
#   log.Print*  log.Output
#   slog.Debug*  slog.Info*  slog.Warn*  slog.Error*  slog.Log*
# log.Fatal*/log.Panic* are deliberately absent — they exit or panic, so
# deleting one is a real behavioural change a test should catch. So are
# method-shaped globs like *.Info, which would reach err.Error() and any
# domain method sharing the name; add those yourself if you want them.
# exclude-calls:
#   - "*.Debug"
#   - "metrics.*"
#   - "tracer.Record"

# Set to false to drop the built-in set above and use only the
# exclude-calls entries you list (or none at all). Default: true.
# exclude-calls-defaults: true

# Available mutator types (26 total):
#   Token-level:
#     ARITHMETIC_BASE             — swap +/-, */%, etc.
#     CONDITIONALS_BOUNDARY       — swap </<=, >/>=
#     CONDITIONALS_NEGATION       — swap ==/!=, </>=, >/<=
#     INCREMENT_DECREMENT         — swap ++/--
#     INVERT_NEGATIVES            — swap -/+ (unary and binary)
#     INVERT_ASSIGNMENTS          — swap arithmetic compound assignments (+=/-=, etc.)
#     INVERT_BITWISE              — swap bitwise binary ops (&/|, ^, <<, >>)
#     INVERT_BITWISE_ASSIGNMENTS  — swap bitwise compound assignments (&=/|=, etc.)
#     INVERT_LOGICAL              — swap &&/||
#     INVERT_LOOP_CTRL            — swap break/continue
#     REMOVE_SELF_ASSIGNMENTS     — drop op from compound assignment (`x += y` → `x = y`)
#     INTEGER_INCREMENT           — integer literal n → n+1
#     INTEGER_DECREMENT           — integer literal n → n-1
#     FLOAT_INCREMENT             — float literal f → f+1.0
#     FLOAT_DECREMENT             — float literal f → f-1.0
#   Block-level:
#     BRANCH_IF                   — empty if/else-if body
#     BRANCH_ELSE                 — empty else body
#     BRANCH_CASE                 — empty case clause body
#     EXPRESSION_REMOVE           — replace &&/|| operand with true/false
#     STATEMENT_REMOVE            — remove assignment/expression/increment side-effects
#     LOOP_CONDITION              — replace `for ...; cond; ... {}` condition with `false`
#     RANGE_BREAK                 — insert `break` as the first statement of a `for…range` body
#   Return values (each return slot is claimed by exactly one of these,
#   based on the type declared in the function's signature):
#     RETURN_ERROR_NIL            — `error` slot → nil (swallow a propagated error)
#     RETURN_ZERO                 — any other slot → its zero value (0, "", nil, *new(T))
#     RETURN_TRUE                 — `bool` slot → true
#     RETURN_FALSE                — `bool` slot → false
